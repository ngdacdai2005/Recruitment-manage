# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# Sao chép file này thành .env để áp dụng cấu hình cho Frontend
# ==============================================================================

# Cổng khởi chạy Vite Dev Server
VITE_PORT=5173

# Base API URL cho Frontend:
# - Chạy Local Dev: dùng '/api/v1' để tận dụng Vite Proxy ngầm chuyển tiếp sang Backend (tránh CORS)
# - Chạy Production: dùng domain thực tế, ví dụ 'https://api.tuyendung.com/api/v1'
VITE_API_URL=/api/v1

# Target Backend Server cho Vite Proxy (dùng trong vite.config.ts)
VITE_BACKEND_TARGET=http://localhost:8080
